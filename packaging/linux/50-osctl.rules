//
// Members of the opensim group may start, stop and restart osctl's instance units (osctl@<name>.service) without
// sudo (PLAN.md "Packaging"). Enabling a unit at boot is not covered: polkit does not say which unit that is for, so
// 'sudo osctl enable <name>'.
polkit.addRule(function (action, subject) {
    if (action.id !== "org.freedesktop.systemd1.manage-units" || !subject.isInGroup("opensim"))
        return polkit.Result.NOT_HANDLED;
    var unit = action.lookup("unit");
    var verb = action.lookup("verb");
    if (unit && /^osctl@[A-Za-z0-9][A-Za-z0-9_-]{0,31}\.service$/.test(unit)
        && ["start", "stop", "restart", "try-restart", "reset-failed", "kill"].indexOf(verb) >= 0)
        return polkit.Result.YES;
    return polkit.Result.NOT_HANDLED;
});
