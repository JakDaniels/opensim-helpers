<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>osctl</AssemblyName>
    <RootNamespace>Osctl</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="3.0.0" />
  </ItemGroup>

  <!-- The default files 'osctl init' writes (and the package installs). -->
  <ItemGroup>
    <EmbeddedResource Include="Defaults/*" LogicalName="Osctl.Defaults.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Osctl.Tests" />
  </ItemGroup>

</Project>
